rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each anonymous user may only touch their own document, and only the `habits` field.
    // Entitlements (Pro) must never be client-writable; keep them in a server-only path.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['habits']);
    }
  }
}

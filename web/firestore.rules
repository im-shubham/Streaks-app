rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // A log doc id is a real-looking day. It may not be more than ~1 day ahead of server time
    // (covers timezones ahead of UTC); anything further is a future-dated completion.
    function validDay(day) {
      return day.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && timestamp.date(int(day[0:4]), int(day[5:7]), int(day[8:10]))
             <= request.time + duration.value(2, 'd');
    }

    match /users/{uid} {
      // Entitlements live ONLY here, written by trusted server code (Admin SDK / payments phase).
      // Clients may read their own entitlement but can never write it.
      match /private/entitlement {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /habits/{habitId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['name', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 28
          && request.resource.data.createdAt is string
          && request.resource.data.createdAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
        allow delete: if isOwner(uid);

        // One document per completed day: the doc id IS the date, so a habit can have at most one
        // completion per calendar day by construction. Logs are append-only (no update).
        match /logs/{day} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid)
            && validDay(day)
            && request.resource.data.keys().hasOnly(['day'])
            && request.resource.data.day == day;
          allow update: if false;
          allow delete: if isOwner(uid); // only used when the whole habit is deleted
        }
      }
    }
  }
}
